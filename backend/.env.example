# Application Info
APP_NAME="NTU EduBot API"

# MongoDB Atlas Configuration
MONGO_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority"
MONGO_DB_NAME="ntu_edubot_db"
VECTOR_COLLECTION="document_chunks"
CHAT_COLLECTION="chat_histories"
VECTOR_INDEX_NAME="vector_index"

# Gemini AI Configuration (Multiple keys separated by commas for round-robin rotation)
GEMINI_API_KEYS="key_1,key_2,key_3"

# Cohere Configuration (For semantic reranking)
COHERE_API_KEY="your_cohere_api_key"

# AI Models
EMBEDDING_MODEL="text-embedding-004"
LLM_MODEL="gemini-2.5-flash"
RERANK_MODEL="rerank-v3.5"
